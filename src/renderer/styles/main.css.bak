/* ═══════════════════════════════════════════════════════════════
   GemVTuber — Premium Dark Glassmorphism Theme
   Designed with Stitch MCP • Space Grotesk + Inter + Material Symbols
   ═══════════════════════════════════════════════════════════════ */

/* ─── Design Tokens ─────────────────────────────────────────── */

:root {
  --accent: #7c5cfc;
  --accent-light: #9d83fc;
  --accent-glow: rgba(124, 92, 252, 0.35);
  --secondary: #ff6b9d;
  --secondary-glow: rgba(255, 107, 157, 0.4);
  --success: #00d68f;
  --success-glow: rgba(0, 214, 143, 0.4);
  --danger: #ff4757;

  --glass: rgba(15, 15, 25, 0.92);
  --glass-subtle: rgba(255, 255, 255, 0.05);
  --glass-hover: rgba(255, 255, 255, 0.08);
  --glass-input: rgba(255, 255, 255, 0.08);
  --glass-card: rgba(255, 255, 255, 0.04);

  --border: rgba(255, 255, 255, 0.10);
  --border-subtle: rgba(255, 255, 255, 0.05);
  --border-focus: rgba(124, 92, 252, 0.6);

  --text: #ffffff;
  --text-90: rgba(255, 255, 255, 0.9);
  --text-70: rgba(255, 255, 255, 0.7);
  --text-50: rgba(255, 255, 255, 0.5);
  --text-40: rgba(255, 255, 255, 0.4);
  --text-30: rgba(255, 255, 255, 0.3);

  --font-headline: 'Space Grotesk', sans-serif;
  --font-body: 'Inter', sans-serif;
  --font-label: 'Public Sans', sans-serif;

  --radius: 12px;
  --radius-sm: 8px;
  --radius-lg: 16px;
  --radius-full: 9999px;

  --transition: 0.2s ease;
  --transition-slow: 0.35s ease;

  --shadow-glow: 0 0 15px rgba(124, 92, 252, 0.25);
  --shadow-deep: 0 8px 32px rgba(0, 0, 0, 0.5);
}

.material-symbols-outlined {
  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}

/* ─── Reset & Transparency ──────────────────────────────────── */

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  background: transparent !important;
  margin: 0;
  padding: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background-color: transparent;
  font-family: var(--font-body);
  color: var(--text);
  user-select: none;
  -webkit-user-select: none;
  -webkit-font-smoothing: antialiased;
}

/* ─── Avatar Canvas ─────────────────────────────────────────── */

#avatar-canvas {
  position: fixed;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: transparent;
}

/* ─── Window Focus Border ───────────────────────────────────── */
#window-border {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  box-sizing: border-box;
  border: 1.5px solid transparent;
  border-radius: var(--radius);
  pointer-events: none;
  z-index: 9999;
  transition: border-color var(--transition);
}

body.window-focused #window-border {
  border-color: rgba(124, 92, 252, 0.35);
}

body.window-resizing #window-border {
  border-color: rgba(124, 92, 252, 0.6);
}

/* ─── Resize Handles ────────────────────────────────────────── */

.resize-handle {
  position: fixed;
  z-index: 9999;
}

.resize-n    { top: 0; left: 10px; right: 10px; height: 6px; cursor: n-resize; }
.resize-s    { bottom: 0; left: 10px; right: 10px; height: 6px; cursor: s-resize; }
.resize-e    { right: 0; top: 10px; bottom: 10px; width: 6px; cursor: e-resize; }
.resize-w    { left: 0; top: 10px; bottom: 10px; width: 6px; cursor: w-resize; }
.resize-nw   { top: 0; left: 0; width: 14px; height: 14px; cursor: nw-resize; }
.resize-ne   { top: 0; right: 0; width: 14px; height: 14px; cursor: ne-resize; }
.resize-sw   { bottom: 0; left: 0; width: 14px; height: 14px; cursor: sw-resize; }
.resize-se   { bottom: 0; right: 0; width: 14px; height: 14px; cursor: se-resize; }

/* Show resize handles on hover when window focused */
body.window-focused .resize-handle:hover {
  background: rgba(124, 92, 252, 0.15);
}

/* ─── Status Bar (Top Right) ────────────────────────────────── */

#status-bar {
  position: fixed;
  top: 12px;
  right: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
  z-index: 50;
  padding: 6px 12px;
  border-radius: var(--radius-full);
  background: var(--glass);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
}

/* Status Indicator Pill */
#status-indicator {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: var(--radius-full);
  background: var(--glass-subtle);
  border: 1px solid var(--border-subtle);
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  transition: all var(--transition);
}

.status-text {
  font-family: var(--font-label);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.5px;
  transition: color var(--transition);
}

/* Status states */
.status-idle .status-dot { background: #666; }
.status-idle .status-text { color: var(--text-50); }

.status-connected .status-dot {
  background: var(--success);
  box-shadow: 0 0 8px var(--success);
  animation: pulse 2s infinite;
}
.status-connected .status-text { color: var(--success); }

.status-speaking .status-dot {
  background: var(--accent);
  box-shadow: 0 0 8px var(--accent);
  animation: pulse 0.8s infinite;
}
.status-speaking .status-text { color: var(--accent); }

.status-listening .status-dot {
  background: var(--secondary);
  box-shadow: 0 0 8px var(--secondary);
  animation: pulse 1.2s infinite;
}
.status-listening .status-text { color: var(--secondary); }

.status-error .status-dot { background: var(--danger); }
.status-error .status-text { color: var(--danger); }

/* Status bar divider */
.status-divider {
  width: 1px;
  height: 20px;
  background: var(--border);
}

/* Action buttons in status bar */
.status-actions {
  display: flex;
  align-items: center;
  gap: 2px;
}

.status-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: var(--radius-full);
  border: none;
  background: transparent;
  color: var(--text-50);
  cursor: pointer;
  transition: all var(--transition);
}

.status-action-btn:hover {
  background: var(--glass-hover);
  color: var(--text);
  transform: scale(1.05);
}

.status-action-btn:active {
  transform: scale(0.95);
}

.status-action-btn .material-symbols-outlined {
  font-size: 20px;
}

/* Mic button states */
.status-action-btn.mic-on { color: var(--accent); }
.status-action-btn.mic-muted { color: var(--danger); }

/* ─── Subtitle Bubble ───────────────────────────────────────── */

#subtitle-container {
  position: fixed;
  bottom: 32px;
  left: 50%;
  transform: translateX(-50%);
  max-width: 80%;
  z-index: 40;
  pointer-events: none;
  padding: 12px 28px;
  background: var(--glass);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-deep);
  animation: fadeSlideUp 0.3s ease;
}

#subtitle-text {
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: 0.02em;
  color: var(--text);
  text-align: center;
}

/* ─── Settings Panel ────────────────────────────────────────── */

#settings-panel {
  position: fixed;
  top: 0; right: 0;
  width: 380px;
  height: 100vh;
  background: var(--glass);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-left: 1px solid var(--border);
  box-shadow: -20px 0 50px rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  flex-direction: column;
  animation: slideInRight 0.35s ease;
}

.settings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 24px;
  border-bottom: 1px solid var(--border);
}

.settings-title {
  font-family: var(--font-headline);
  font-size: 20px;
  font-weight: 700;
  color: var(--text);
  display: flex;
  align-items: center;
  gap: 8px;
}

.settings-body {
  flex: 1;
  overflow-y: auto;
  padding: 24px;
}

/* Custom scrollbar */
.settings-body::-webkit-scrollbar { width: 4px; }
.settings-body::-webkit-scrollbar-track { background: transparent; }
.settings-body::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: var(--radius-full); }
.settings-body::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.2); }

/* Settings sections */
.settings-section {
  margin-bottom: 28px;
}

.section-label {
  font-family: var(--font-label);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--accent);
  margin-bottom: 12px;
}

/* ─── Window Border Overlay ────────────────────────────────────── */
#window-border {
  position: fixed;
  top: 0; left: 0;
  width: 100vw; height: 100vh;
  box-sizing: border-box;
  border: 1px solid transparent;
  border-radius: var(--radius);
  pointer-events: none;
  z-index: 9999;
  transition: border-color var(--transition);
}

body.window-focused #window-border {
  border-color: var(--border-focus);
}

/* ─── Inputs (Stitch-inspired) ──────────────────────────────── */

input[type="password"],
input[type="text"],
textarea {
  width: 100%;
  padding: 10px 14px;
  background: var(--glass-input);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text-90);
  font-family: var(--font-body);
  font-size: 13px;
  outline: none;
  transition: all var(--transition);
}

input:focus, textarea:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px var(--accent-glow);
}

input::placeholder, textarea::placeholder {
  color: var(--text-30);
}

textarea {
  resize: none;
  min-height: 72px;
  margin-top: 10px;
}

/* Input with trailing icon */
.input-with-icon {
  position: relative;
}

.input-with-icon input {
  padding-right: 40px;
}

.input-icon-btn {
  position: absolute;
  right: 8px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  color: var(--text-40);
  cursor: pointer;
  padding: 4px;
  border-radius: var(--radius-sm);
  transition: color var(--transition);
}

.input-icon-btn:hover { color: var(--text); }
.input-icon-btn .material-symbols-outlined { font-size: 18px; }

/* Hint link */
.hint-link {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  font-weight: 500;
  color: var(--accent);
  text-decoration: none;
  margin-top: 8px;
  cursor: pointer;
  transition: color var(--transition);
}

.hint-link:hover { color: var(--secondary); }
.hint-link-icon { font-size: 14px !important; }

/* ─── Select Dropdowns ──────────────────────────────────────── */

.select-wrapper {
  position: relative;
}

.select-wrapper select {
  width: 100%;
  appearance: none;
  padding: 10px 36px 10px 14px;
  background: var(--glass-input);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text-90);
  font-family: var(--font-body);
  font-size: 13px;
  cursor: pointer;
  outline: none;
  transition: all var(--transition);
}

.select-wrapper.has-icon select {
  padding-left: 38px;
}

.select-wrapper select:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px var(--accent-glow);
}

.select-wrapper select option {
  background: #1a1a2e;
  color: var(--text);
}

.select-arrow {
  pointer-events: none;
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-50);
}

.select-arrow .material-symbols-outlined { font-size: 18px; }

.select-icon {
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-40);
  font-size: 18px !important;
  pointer-events: none;
}

/* ─── Model Card ────────────────────────────────────────────── */

.model-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border-radius: var(--radius-sm);
  background: var(--glass-card);
  border: 1px solid var(--border-subtle);
  margin-bottom: 10px;
}

.model-icon {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-sm);
  background: var(--glass-hover);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.model-icon .material-symbols-outlined {
  color: var(--text-50);
  font-size: 20px;
}

.model-name-display {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-90);
  font-style: italic;
}

.model-hint {
  font-size: 10px;
  color: var(--text-40);
  margin-top: 2px;
}

/* ─── Action Button ─────────────────────────────────────────── */

.action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 20px;
  background: linear-gradient(135deg, var(--accent), var(--accent-light));
  color: white;
  border: none;
  border-radius: var(--radius-sm);
  font-family: var(--font-headline);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition);
  box-shadow: 0 4px 15px var(--accent-glow);
}

.action-btn:hover {
  box-shadow: 0 6px 20px var(--accent-glow);
  transform: translateY(-1px);
}

.action-btn:active { transform: translateY(0); }

.action-btn-full { width: 100%; }

.action-btn .material-symbols-outlined { font-size: 18px; }

/* ─── Toggle Switch ─────────────────────────────────────────── */

.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.toggle-label-text {
  font-size: 13px;
  color: var(--text-90);
  display: flex;
  flex-direction: column;
}

.toggle-sublabel {
  font-size: 10px;
  color: var(--text-40);
  margin-top: 2px;
}

.toggle-switch {
  position: relative;
  width: 40px;
  height: 20px;
  flex-shrink: 0;
}

.toggle-switch input { opacity: 0; width: 0; height: 0; }

.toggle-slider {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-full);
  cursor: pointer;
  transition: all var(--transition);
}

.toggle-slider::before {
  content: '';
  position: absolute;
  width: 16px;
  height: 16px;
  left: 2px;
  bottom: 2px;
  background: white;
  border-radius: 50%;
  transition: all var(--transition);
}

.toggle-switch input:checked + .toggle-slider {
  background: var(--success);
  box-shadow: 0 0 10px var(--success-glow);
}

.toggle-switch input:checked + .toggle-slider::before {
  transform: translateX(20px);
}

/* ─── Sliders ───────────────────────────────────────────────── */

.slider-group {
  margin-top: 16px;
}

.slider-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.slider-label {
  font-size: 12px;
  color: var(--text-70);
}

.slider-value {
  font-family: var(--font-headline);
  font-size: 12px;
  font-weight: 700;
}

.slider-value.accent { color: var(--accent); }
.slider-value.secondary { color: var(--secondary); }

.slider-track-wrapper {
  position: relative;
  width: 100%;
}

input[type="range"] {
  -webkit-appearance: none;
  width: 100%;
  height: 4px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.1);
  outline: none;
  border: none;
  padding: 0;
  cursor: pointer;
}

input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: white;
  cursor: pointer;
  box-shadow: 0 0 10px var(--accent-glow);
  transition: box-shadow var(--transition);
}

input[type="range"]::-webkit-slider-thumb:hover {
  box-shadow: 0 0 0 6px var(--accent-glow), 0 0 12px var(--accent-glow);
}

.slider-bounds {
  display: flex;
  justify-content: space-between;
  font-size: 10px;
  color: var(--text-30);
  margin-top: 4px;
}

/* Volume row */
.volume-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid var(--border-subtle);
}

.volume-icon {
  color: var(--text-40);
  font-size: 18px !important;
}

.volume-row .slider-track-wrapper {
  flex: 1;
}

.volume-row .slider-value {
  min-width: 32px;
  text-align: right;
}

/* ─── Context Menu ──────────────────────────────────────────── */

#context-menu {
  position: fixed;
  min-width: 200px;
  background: var(--glass);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 6px;
  z-index: 200;
  box-shadow: var(--shadow-deep);
  animation: fadeIn 0.15s ease;
}

.ctx-header {
  padding: 8px 12px 6px;
  border-bottom: 1px solid var(--border-subtle);
  margin-bottom: 4px;
}

.ctx-header-title {
  font-family: var(--font-label);
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--accent);
}

.ctx-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 8px 12px;
  background: transparent;
  border: none;
  border-radius: var(--radius-sm);
  color: var(--text-70);
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition);
}

.ctx-item:hover {
  background: var(--glass-hover);
  color: var(--text);
}

.ctx-emoji {
  font-size: 16px;
  opacity: 0.7;
}

.ctx-item:hover .ctx-emoji { opacity: 1; }

.ctx-item-danger {
  color: var(--secondary);
}

.ctx-item-danger:hover {
  background: rgba(255, 107, 157, 0.1);
}

.ctx-divider {
  border: none;
  border-top: 1px solid var(--border);
  margin: 4px 8px;
}

/* ─── Utility ───────────────────────────────────────────────── */

.hidden { display: none !important; }

/* ─── Animations ────────────────────────────────────────────── */

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

@keyframes slideInRight {
  from { transform: translateX(100%); opacity: 0; }
  to   { transform: translateX(0); opacity: 1; }
}

@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.95); }
  to   { opacity: 1; transform: scale(1); }
}

@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateX(-50%) translateY(10px); }
  to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}
