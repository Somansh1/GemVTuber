{
  "name": "gem-vtuber",
  "version": "0.1.0",
  "description": "Electron desktop companion: a transparent Live2D avatar driven by the Gemini Live API",
  "main": "src/main/main.js",
  "scripts": {
    "build": "node build.js && node -e \"const fs=require('fs');const p=require('path');fs.mkdirSync(p.join('dist','renderer'),{recursive:true});fs.copyFileSync(p.join('src','renderer','audio','pcm-processor.js'),p.join('dist','renderer','pcm-processor.js'))\"",
    "prestart": "npm run build",
    "start": "electron .",
    "predev": "npm run build",
    "dev": "electron . --dev",
    "watch": "node build.js --watch",
    "package": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Somansh1/gem-companion-vtuber.git"
  },
  "keywords": [
    "vtuber",
    "gemini",
    "live2d",
    "desktop-companion",
    "ai-avatar",
    "desktop-pet",
    "gemini-live-api",
    "ai-vtuber",
    "virtual-assistant",
    "transparent-overlay"
  ],
  "author": "Somansh1",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.11",
    "marked-highlight": "^2.2.4",
    "pixi.js": "^8.18.1",
    "untitled-pixi-live2d-engine": "^1.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "babel-jest": "^30.4.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "jest": "^29.7.0"
  },
  "homepage": "https://github.com/Somansh1/gem-companion-vtuber#readme",
  "bugs": {
    "url": "https://github.com/Somansh1/gem-companion-vtuber/issues"
  }
}
